      "priority": "high",
      "description": "Verify product catalog displays correctly and scrolling works",
      "steps": [
        {
          "action": "assert_contains",
          "assert_contains": "Products",
          "note": "Verify home screen shows Products"
        },
        {
          "action": "visual_check",
          "note": "Check product grid layout"
        },
        {
          "action": "scroll",
          "direction": "down",
          "note": "Scroll to load more products"
        },
        {
          "action": "wait",
          "seconds": 1.0
        },
        {
          "action": "scroll",
          "direction": "down",
          "note": "Scroll more"
        },
        {
          "action": "wait",
          "seconds": 1.0
        },
        {
          "action": "scroll",
          "direction": "up",
          "note": "Scroll back up"
        },
        {
          "action": "visual_check",
          "note": "Verify scroll state preserved"
        }
      ]
    },
