    ORCH -->|"pick_next_action"| EXP
    ENG -->|"execute action"| NAV
    ENG -->|"repair session"| REC
    ENG -->|"evaluate_and_update"| CRIT
    CRIT -->|"verdict: +1.0 pass / -1.5 fail"| SESS
    SESS -.->|"action weights penalised set"| EXP
    ORCH -->|"ingest"| DOC
    ORCH -->|"gen script"| SGEN
    ORCH -->|"exec"| SEXE
    ORCH ==>|"parallel audit"| A11Y
    ORCH ==>|"parallel audit"| SEC
    ORCH -->|"report"| REP
    ORCH -->|"localize"| BUG_LOC
    KB -.->|"app archetype + predicted screens"| ORCH
    ENG <-.->|"every step"| SESS
    ORCH <-.->|"smart-test"| KB
    DOC -->|"features"| KB
    SGEN -.->|"nav paths"| KB
    SEXE -.->|"results"| KB
    NAV --> UI_EXT
    NAV <-->|"Appium WebDriver"| APPCTL
    REC -->|"restart"| APPCTL
    EXP -->|"visual inspect"| VLM_MOD
    A11Y -->|"vision-cached"| VLM_MOD
    PLAN & EXP & CRIT -->|"ask_text"| VLM_MOD
    NAV & REC & SGEN -->|"ask_text"| VLM_MOD
    REP -->|"ask_text"| VLM_MOD
    APPCTL --> ADB_MOD

