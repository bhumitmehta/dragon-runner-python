    %% ═══════════════════════════════════════════════
    %%  PROJECT 1: PYTHON AGENT (12-Agent System)
    %% ═══════════════════════════════════════════════

    subgraph PYTHON_AGENT ["🐉 python_agent/ — AI Multi-Agent Mobile Testing"]
        direction TB

        CLI["main.py CLI --explorer | --multiagent --task | --smart-test --workflow | --interactive"]:::core

        subgraph POLICY ["POLICY LAYER — decides WHAT"]
            direction TB
            ORCH["ORCHESTRATOR Mode routing · directive refresh archetype trigger · step budget parallel audits · report generation"]:::core
        end

        subgraph EXECUTION ["EXECUTION ENGINE — decides HOW"]
            direction TB
            ENG["ExecutionEngine Action dispatch · Critic eval weight update · retry · screen caching"]:::agent
        end

        subgraph COGNITION ["COGNITION LAYER"]
            direction LR
            PLAN["PLANNER Session-level goals ExplorationDirective time horizon: LONG"]:::agent
            CRIT["CRITIC evaluate_and_update verdict + weight push learning pressure"]:::agent
            EXP["EXPLORER Screen-level curiosity directive-bounded weight-biased time horizon: SHORT"]:::agent
        end

        subgraph PERCEPTION ["PERCEPTION LAYER"]
            direction LR
            NAV["NAVIGATOR UI context capture action execution coordinate fallback click · input · scroll back · long_press · assert"]:::agent
            REC["RECOVERY Session repair crash detection dialog dismissal hard reset"]:::agent
        end

        subgraph SKILL ["SKILL LAYER (Smart-Test)"]
            direction LR
            DOC["DOC INGESTION Parse .md/.txt/.rst extract features priority + expected_behavior"]:::agent
            SGEN["SCRIPT GENERATOR Feature → nav scripts + verification scripts runtime locator resolution"]:::agent
            SEXE["SCRIPT EXECUTOR Run scripts _execute_step_with_fallback direct → LLM retry"]:::agent
        end

        subgraph AUDIT ["QUALITY GATES (Parallel)"]
            direction LR
            A11Y["ACCESSIBILITY WCAG audit per screen touch targets · contrast missing descriptions"]:::agent
            SEC["SECURITY Data leak scan auth testing injection inputs password masking"]:::agent
        end

        subgraph OUTPUT_AGENTS ["OUTPUT LAYER"]
            direction LR
            REP["REPORTER Markdown + JSON reports bug summaries coverage analysis"]:::agent
            BUG_LOC["BUG LOCALIZER UniXcoder embeddings source code mapping bug → file:line"]:::agent
        end

        subgraph MEM ["PERSISTENT STATE"]
            direction LR
            SESS[("SessionMemory (In-Process) Screen graph · action log loop detector · bug list coverage · action weights")]:::memory
            KB[("KnowledgeBase (TinyDB — Cross-Run) features · nav paths test results · app archetype predicted screens · runs")]:::memory
        end

        subgraph INFRA_LAYER ["INFRASTRUCTURE"]
            direction LR
            APPCTL["AppiumController WebDriver wrapper W3C Actions API element ops · screenshots coordinate tap/type"]:::infra
            VLM_MOD["VLM Module (vlm.py) Vision: qwen3-vl:235b-cloud Text: gpt-oss:120b-cloud Parallel model racing VLM caching"]:::llm
            UI_EXT["UI Extract XML page source parsing element bounds extraction coordinate fallback"]:::infra
            ADB_MOD["ADB Utilities Device connectivity app install/uninstall logcat · emulator mgmt"]:::infra
            CFG["config.py + .env APP_PACKAGE · APPIUM_HOST OLLAMA_HOST · MAX_STEPS MODEL configs"]:::infra
        end
    end

    %% ── Python Agent Internal Flows ──
    CLI ==>|"all modes"| ORCH
    ORCH ==>|"delegates actions"| ENG
    ORCH -->|"exploration directive"| PLAN
